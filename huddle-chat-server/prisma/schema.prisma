// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  name             String
  avatar           String?
  workOrCollege    String?
  bio              String?
  interests        String[]
  skills           String[]
  favoriteCategories String[]
  lookingFor       String[]
  preferences      Json?
  location         String?
  socialLinks      Json?
  googleId         String?   @unique
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdLobbies   Lobby[]   @relation("LobbyCreator")
  participatingLobbies LobbyParticipant[]
  messages         LobbyMessage[]
}

model Lobby {
  id               String    @id @default(uuid())
  title            String
  description      String
  category         String
  date             String
  time             String
  location         String
  maxParticipants  Int?
  visibility       String    @default("Public")
  tags             String?
  coverImage       String?
  categoryDetails  Json?
  creatorId        String
  active           Boolean   @default(true)
  creator          User      @relation("LobbyCreator", fields: [creatorId], references: [id])
  participants     LobbyParticipant[]
  messages         LobbyMessage[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model LobbyMessage {
  id        String   @id @default(uuid())
  content   String
  userId    String
  lobbyId   String
  user      User     @relation(fields: [userId], references: [id])
  lobby     Lobby    @relation(fields: [lobbyId], references: [id])
  createdAt DateTime @default(now())
}


model LobbyParticipant {
  id        String   @id @default(uuid())
  userId    String
  lobbyId   String
  user      User     @relation(fields: [userId], references: [id])
  lobby     Lobby    @relation(fields: [lobbyId], references: [id])
  joinedAt  DateTime @default(now())

  @@unique([userId, lobbyId])
}